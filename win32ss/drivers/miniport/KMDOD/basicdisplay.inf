; VBE SVGA driver
[AddReg]
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay","ErrorControl",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay","Group",0x00000000,"Video Save"
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay","ImagePath",0x00020000,"system32\drivers\BasicDisplay.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay","Start",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay","Type",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay","Tag",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Video","Service",0x00000000,"BasicDisplay"

HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","InstalledDisplayDrivers",0x00010000,"cdd"
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","DefaultSettings.VRefresh",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","DefaultSettings.BitsPerPel",0x00010001,32
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","DefaultSettings.XResolution",0x00010001,800
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","DefaultSettings.YResolution",0x00010001,600
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","DefaultSettings.FixedOutput",0x00010001,0
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","DefaultSettings.Flags",0x00010001,0
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","DefaultSettings.Orientation",0x00010001,0
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","DefaultSettings.XPanning",0x00010001,0
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","DefaultSettings.YPanning",0x00010001,0
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","Attach.RelativeX",0x00010001,0
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","Attach.RelativeY",0x00010001,0
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","Attach.ToDesktop",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","Attach.PrimaryDevice",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","Device Description",0x00000000,"ReactOS Basic Display Driver"

; This is not true but it allows to use 3rd party drivers while having the VBE driver installed
HKLM,"SYSTEM\CurrentControlSet\Services\vga\Device0","VgaCompatible",0x00010001,1
